# LearnOS Server Environment Configuration
PORT=5000

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://shashank-785.github.io

# Required: Generate a random 32+ byte secret:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Optional Data Directory Override (recommended for Render Persistent Disk or multi-user deployments)
# LEARNOS_DATA_DIR=

# Centralized AI Provider Architecture (Backend-Only Credentials)
# Supported AI_PROVIDER values: auto | gemini | groq | openrouter | openai | ollama | local | fallback
AI_PROVIDER=auto
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
OLLAMA_BASE_URL=http://localhost:11434

# Optional Local Embedded llama.cpp GGUF Configuration
LEARNOS_GPU=auto
# Optional absolute path; defaults to ~/.learnos/models/Qwen3-1.7B-Q8_0.gguf
# LEARNOS_MODEL_PATH=C:\Users\your-name\.learnos\models\Qwen3-1.7B-Q8_0.gguf

# Isolated Multi-Language Code Sandbox (Piston v2 compatible)
PISTON_API_URL=https://emkc.org/api/v2/piston/execute
